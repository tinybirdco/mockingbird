{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@tinybirdco/mockingbird#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "web#build": {
      "dependsOn": ["@tinybirdco/mockingbird#build"],
      "outputs": [".next/**"]
    }
  }
}
